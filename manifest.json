{
  "manifest_version": 3,
  "name": "LitRPG Release Watch",
  "version": "1.0.0",
  "description": "Monitor Audible and Amazon for book series updates and get notified of new releases",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.audible.com/*",
    "https://www.amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://www.audible.co.uk/*",
    "https://www.amazon.co.uk/*",
    "https://www.audible.ca/*",
    "https://www.amazon.ca/*",
    "https://www.audible.de/*",
    "https://www.amazon.de/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.audible.com/*",
        "https://www.amazon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
